{
  "name": "tmg180",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node init && pnpm --parallel --filter \"./apps/*\" dev",
    "dev:web": "pnpm --filter @tmg180/web dev",
    "dev:api": "pnpm --filter @tmg180/api dev",
    "build": "node init && pnpm -r build",
    "start": "node init && pnpm --filter @tmg180/api start",
    "lint": "oxlint",
    "clean": "pnpm -r exec rm -rf dist node_modules && rm -rf node_modules"
  },
  "devDependencies": {
    "oxlint": "^1.71.0"
  }
}
